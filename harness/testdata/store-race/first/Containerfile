# Built first by TestBuildBesideImageRemoval: its first step is the one
# store-race/second takes from the cache, and its image goes while that
# build is still running.

FROM docker.io/library/busybox:1.38.0-musl@sha256:80e38f9a1b39188b8bdb28879178edb322a4402b081a9aedda1924609decd6f6

# The step both builds share
RUN echo shared > /shared
# DL3059 would fold this into the step above, which both builds share:
# this one is apart on purpose, the one that tells them apart
# hadolint ignore=DL3059
RUN echo first > /first
