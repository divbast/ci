includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    # The PHP the images run, whichever runs the analyser
    phpVersion: 80500
    paths:
        - harness/probe
        # The minimal fixture's PHP, its health probe by name since it has
        # no .php
        - contract/testdata/minimal
        - contract/testdata/minimal/minimal-health
