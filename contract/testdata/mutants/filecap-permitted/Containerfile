# The minimal fixture with cap_net_bind_service=p on its FrankenPHP binary:
# permitted, with no effective bit. The kernel runs such a binary under
# --cap-drop ALL as it would any other, granting it nothing, so it starts
# and serves, and only a scan of the image's layers can see the
# capability. COPY --from keeps the security.capability extended
# attribute, under BuildKit and Buildah alike.

# The minimal fixture, which the test builds and passes in
ARG FIXTURE

FROM ${FIXTURE} AS fixture

FROM docker.io/library/debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS setcap
# DL3008 asks for apt versions to be pinned. The base is pinned by digest,
# and setcap only marks a test binary here: nothing of this stage but that
# binary reaches the image, and a pin would break at Debian's next point
# release.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
COPY --from=fixture /usr/local/bin/frankenphp /frankenphp
# The build fails here, rather than the test later, if the capability did
# not take.
RUN setcap cap_net_bind_service=p /frankenphp \
    && test "$(getcap /frankenphp)" = '/frankenphp cap_net_bind_service=p'

FROM fixture
COPY --from=setcap /frankenphp /usr/local/bin/frankenphp
