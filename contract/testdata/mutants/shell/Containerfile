# The fixture with a shell at /bin/sh: BusyBox's musl build, which is
# static and so runs anywhere.

# testfixture.LibreSpeed, pinned by its index digest, which the test
# passes in so that the fixture is named in one place only
ARG FIXTURE

FROM docker.io/library/busybox:1.38.0-musl@sha256:80e38f9a1b39188b8bdb28879178edb322a4402b081a9aedda1924609decd6f6 AS busybox

FROM ${FIXTURE}
# /bin is a link to usr/bin in the fixture, so this lands at /usr/bin/sh
COPY --from=busybox /bin/busybox /bin/sh
